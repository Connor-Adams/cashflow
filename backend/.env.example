PORT=3001
CORS_ORIGIN=http://localhost:5173
# Optional — share the session cookie across UI/API subdomains under one parent
# domain (e.g. `.yourdomain.com`). REQUIRED in prod when the UI and API are on
# different subdomains, or Safari/iOS drop the cookie and auth fails. Unset for
# local/single-host. See docs/deploy-railway.md → "Cookies across subdomains".
# SESSION_COOKIE_DOMAIN=.yourdomain.com
# Set DATABASE_URL to use Postgres. If omitted, the backend falls back to SQLite.
# DATABASE_URL=postgresql://user:password@localhost:5432/cashflow
DATABASE_PATH=./data/cashflow.sqlite
CSV_UPLOAD_DIR=./uploads/csv
RECEIPTS_UPLOAD_DIR=./uploads/receipts
DEFAULT_CURRENCY=CAD
CSV_PROFILE_ID=generic_simple

# Optional — AI categorization + receipt vision (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# AI_RATE_LIMIT_MAX=20

# Optional — Alpha Vantage stock quotes (https://www.alphavantage.co/support/#api-key)
# Free tier is 25 calls/day, 5 calls/min. The scheduler defaults to a 22/day
# budget to leave headroom for the manual /portfolio/prices/refresh endpoint.
# ALPHA_VANTAGE_API_KEY=
# QUOTE_PROVIDER=alpha_vantage
# QUOTE_SCHEDULER_ENABLED defaults to true whenever ALPHA_VANTAGE_API_KEY is set
# in non-test environments. Set to false to disable the background refresh.
# QUOTE_SCHEDULER_ENABLED=true
# QUOTE_DAILY_BUDGET=22
# QUOTE_TICK_CRON=*/4 * * * *
# QUOTE_MIN_AGE_HOURS=18
# Auto-create InvestmentActivity dividend rows from AV-fetched DIVIDENDS data.
# Defaults to true outside the test env. Set DIVIDEND_DEDUP_DAYS to widen or
# tighten the ±days window used to detect a matching broker-imported row.
# DIVIDEND_RECONCILE_ENABLED=true
# DIVIDEND_DEDUP_DAYS=5

# Optional — Costco product-image enrichment (requires a hosted scraper key)
# COSTCO_ENRICHMENT_ENABLED defaults to false. Set to true to enable background
# resolution of Costco receipt item images. Requires COSTCO_SCRAPER_API_KEY.
# COSTCO_ENRICHMENT_ENABLED=false
# COSTCO_SCRAPER_API_KEY=
# COSTCO_SCRAPER_BASE_URL=https://data.unwrangle.com/api/getter/
# COSTCO_ENRICHMENT_MAX_ITEMS_PER_RUN=50
# Costco enrichment provider: 'unwrangle' (paid, item-number-verified) or 'google' (free, best-effort image)
# COSTCO_SCRAPER_PROVIDER=unwrangle
# Google Custom Search (free 100/day) — used when COSTCO_SCRAPER_PROVIDER=google
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# --- Observability (Phase 2+) ---
# Set to enable OTLP log export to the collector. Unset (or OTEL_SDK_DISABLED=true)
# disables OTLP and falls back to stdout-only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.railway.internal:4318
# OTEL_SDK_DISABLED=false
# GIT_SHA=local
