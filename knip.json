{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "backend": {
      "entry": [
        "src/app.ts",
        "src/db.ts",
        "scripts/*.{ts,cjs,js}",
        "test/**/*.test.ts",
        "src/migrations/*.{ts,cjs,js}"
      ],
      "project": "src/**/*.ts"
    },
    "frontend": {
      "entry": [
        "index.html",
        "src/bookmarklets/{amazon,apple}.ts",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": ["tailwindcss"]
    },
    "shared": {
      "entry": ["*.ts"],
      "project": "**/*.ts"
    }
  }
}
